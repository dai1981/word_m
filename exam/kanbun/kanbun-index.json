[{"id":"imada","midashi":"未（いまだ〜ず）","yomi":"いまダ〜ず","kana":"イマダ","core":"まだ〜ない","level":"最重要","means":["まだ〜ない・いまだに〜しない"]},{"id":"ukemi","midashi":"見・被・為A所B（受身）","yomi":"る・らル／〜のB所と為る","kana":"ウケミ","core":"AがBされる（受身）","level":"最重要","means":["（見・被＋動詞で）〜される","（為A所Bで）AにBされる"]},{"id":"oite","midashi":"於・于・乎（置き字）","yomi":"〜に／〜より／〜を（送り仮名に反映）","kana":"オ","core":"場所・対象・起点・比較を示す置き字","level":"重要","means":["（場所・時）〜に・〜で","（対象）〜に・〜に対して","（起点・比較）〜より"]},{"id":"gimon","midashi":"何・安・誰・乎（疑問）","yomi":"なんゾ／いづクニカ／たれ／〜や・か","kana":"ギモン","core":"何・どこ・だれ・〜か（疑問）","level":"重要","means":["（何）なに・なぜ・どうして","（安・悪）どこに・どうして","（誰）だれ","（乎・也＋疑問）〜か"]},{"id":"gojippo","midashi":"五十歩百歩","yomi":"ごじっぽひゃっぽ","kana":"ゴジッポヒャッポ","core":"少しの違いはあるが、本質は同じで大差ないこと","level":"重要","means":["少しの違いはあるが、本質的には同じで大差ないこと"]},{"id":"shieki","midashi":"使・令（使役）","yomi":"しム／〜をして…しむ","kana":"シエキ","core":"AをしてB(せ)しむ＝AにBさせる","level":"最重要","means":["AをしてB(せ)しむ＝AにBさせる","AにBするよう命じる・仕向ける"]},{"id":"sha","midashi":"謝（あやまる）","yomi":"あやまル／ことわル／しゃス","kana":"シャ","core":"あやまる／ことわる／礼を言う／いとまごいする","level":"重要","means":["あやまる・わびる","断る・辞退する","礼を言う・感謝する","別れを告げる・いとまごいする"]},{"id":"wakashi","midashi":"少（わかし）","yomi":"わかシ／すくなシ","kana":"ショウ","core":"年が若い（幼い）／少ない","level":"重要","means":["年が若い・幼い","少ない・わずかだ","しばらく・少し"]},{"id":"shikoushite","midashi":"而（置き字・接続）","yomi":"しかうして／しかも／て・で","kana":"ジ","core":"前後をつなぐ接続の置き字（順接・逆接）","level":"重要","means":["（順接）〜て・そして","（逆接）〜のに・しかし"]},{"id":"gotoshi","midashi":"如・若（ごとし・しく・もし）","yomi":"ごとシ／しク／もシ","kana":"ジョ","core":"〜のようだ／〜に及ぶ／もし〜ならば","level":"最重要","means":["〜のようだ・〜と同じだ","〜に及ぶ・匹敵する","もし〜ならば","おまえ・その"]},{"id":"subekaraku","midashi":"須（すべからく〜べし）","yomi":"すべかラク〜ベし","kana":"スベカラク","core":"ぜひ〜する必要がある・当然〜すべきだ","level":"重要","means":["ぜひ〜する必要がある・〜しなければならない"]},{"id":"dasoku","midashi":"蛇足","yomi":"だそく","kana":"ダソク","core":"余計な付け足し・無用のもの","level":"重要","means":["余計な付け足し・無用のもの"]},{"id":"nijuuhitei","midashi":"無A不B（二重否定）","yomi":"AトシテBセ(ざ)ルハなシ","kana":"ニジュウヒテイ","core":"AでBしないものはない＝すべてAはBする（強い肯定）","level":"重要","means":["（無A不B）AとしてBしないもの